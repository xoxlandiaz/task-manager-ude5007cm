# Скопировать в .env и заполнить. .env не коммитить.

# --- Приложение ---
PORT=3000
NODE_ENV=development
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# --- База данных ---
# Локально без Docker: postgres://postgres:postgres@localhost:5432/taskmanager
# В docker compose хост базы называется db (DATABASE_URL собирается из POSTGRES_* ниже)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskmanager
# true для внешних подключений к облачной БД (например, Render External URL)
DATABASE_SSL=false

# --- Только для docker compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmanager
HTTP_PORT=80
